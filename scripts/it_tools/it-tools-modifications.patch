new file mode 100644
index 0000000..0383ee0
--- /dev/null
+++ b/src/assets/mobile.css
@@ -0,0 +1,115 @@
+/**
+ * 移动端 / 内嵌 WebView 基线样式。
+ *
+ * 只放全局、跨组件的兜底规则；组件级适配写在各自组件的样式里。
+ * 断点阈值与 src/responsive/breakpoints.ts 保持一致。
+ */
+
+html {
+  /* 禁止移动端因聚焦或横竖屏切换导致的字号自动缩放 */
+  -webkit-text-size-adjust: 100%;
+  text-size-adjust: 100%;
+}
+
+html,
+body {
+  /* 兜底：个别工具页的超宽内容不应把整页顶出横向滚动 */
+  overflow-x: hidden;
+  max-width: 100%;
+}
+
+body {
+  /* 关闭下拉橡皮筋/刷新手势，贴近原生 App 观感 */
+  overscroll-behavior-y: none;
+}
+
+#app {
+  min-height: 100vh;
+  min-height: 100dvh;
+}
+
+@media (max-width: 700px) {
+  /* 去掉点击高亮色块，反馈交给组件自身的 active 态 */
+  * {
+    -webkit-tap-highlight-color: transparent;
+  }
+
+  /* 触摸滚动惯性 */
+  .n-layout-scroll-container {
+    -webkit-overflow-scrolling: touch;
+  }
+
+  /*
+   * naive-ui 表单窄屏适配（全站 68 处 n-form-item 依赖此规则）
+   *
+   * naive 的 n-form-item 是 grid 布局，label-placement="left" 时用
+   * grid-template-areas 分成 "label blank" 两列，并给 label 定死宽度
+   * （如 label-width="200"，在 360px 屏上会把输入框挤到只剩 160px）。
+   * 这里在窄屏下把它强制还原成 top 堆叠，等价于 label-placement="top"。
+   *
+   * 选择器比 naive 自身多一层类名，保证不依赖样式注入顺序；label 宽度用
+   * !important 覆盖 naive 写在行内 style 上的 width。
+   */
+  .n-form-item.n-form-item--left-labelled {
+    grid-template-areas:
+      'label'
+      'blank'
+      'feedback';
+    grid-template-columns: minmax(0, 1fr);
+  }
+
+  .n-form-item.n-form-item--left-labelled > .n-form-item-label {
+    width: auto !important;
+    min-width: 0 !important;
+    justify-content: flex-start;
+    text-align: left;
+    padding-right: 0;
+  }
+
+  /* auto-label-width 会强制 nowrap，窄屏下允许换行 */
+  .n-form-item.n-form-item--auto-label-width .n-form-item-label {
+    white-space: normal;
+  }
+
+  .n-form-item .n-form-item-blank {
+    min-width: 0;
+  }
+
+  /* 表格类内容在窄屏下横向滚动，避免撑破卡片 */
+  .n-table {
+    display: block;
+    width: 100%;
+    overflow-x: auto;
+    -webkit-overflow-scrolling: touch;
+  }
+
+  /*
+   * naive-ui 网格窄屏折叠为单列。
+   *
+   * n-grid 用行内 style 写 grid-template-columns，n-gi 渲染成无 class 的裸 div
+   * （只有行内 gridColumn），所以只能靠 !important + '.n-grid > *' 覆盖。
+   * 全站仅 6 处 n-grid，且都是"标签 + 控件"型布局，手机端单列更合理。
+   */
+  .n-grid {
+    grid-template-columns: minmax(0, 1fr) !important;
+  }
+
+  .n-grid > * {
+    grid-column: auto / span 1 !important;
+    margin-left: 0 !important;
+  }
+
+  /* n-input-number 的加减按钮实测只有 18px 宽，很难点中；
+     只加宽不加高，避免把输入框撑高改变布局 */
+  .n-input-number .n-button {
+    min-width: 26px;
+  }
+
+  /* 窄屏没有 hover 可用，n-ellipsis 的省略号等于把内容藏了：改为换行 */
+  .n-ellipsis {
+    white-space: normal !important;
+    overflow: visible !important;
+    text-overflow: clip !important;
+    word-break: break-word;
+  }
+}

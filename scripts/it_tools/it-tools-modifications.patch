new file mode 100644
index 0000000..f7d5396
--- /dev/null
+++ b/src/modules/command-palette/command-palette-dialog.vue
@@ -0,0 +1,138 @@
+<script setup lang="ts">
+import { storeToRefs } from 'pinia';
+import _ from 'lodash';
+import { useCommandPaletteStore } from './command-palette.store';
+import type { PaletteOption } from './command-palette.types';
+
+/**
+ * 命令面板弹层本体。
+ *
+ * 与触发器（command-palette.vue）分开的原因：内嵌模式下宿主 App 会用
+ * `window.ItTools.openSearch()` 打开它，而页内导航头是被隐藏/移除的——
+ * 弹层若挂在导航头里就会随之一并消失。因此它由 App.vue 常驻挂载一次。
+ */
+const inputRef = ref();
+const router = useRouter();
+const { searchPrompt, filteredSearchResult, isOpen } = storeToRefs(useCommandPaletteStore());
+const commandPaletteStore = useCommandPaletteStore();
+
+const keys = useMagicKeys({
+  passive: false,
+  onEventFired(e) {
+    if ((e.ctrlKey || e.metaKey) && e.key === 'k' && e.type === 'keydown') {
+      e.preventDefault();
+    }
+  },
+});
+
+whenever(isOpen, () => inputRef.value?.focus());
+
+whenever(keys.ctrl_k, () => commandPaletteStore.open());
+whenever(keys.meta_k, () => commandPaletteStore.open());
+whenever(keys.escape, () => commandPaletteStore.close());
+
+const selectedOptionIndex = ref(0);
+
+function handleKeydown(event: KeyboardEvent) {
+  const { key } = event;
+  const isEnterPressed = key === 'Enter';
+  const isArrowUpOrDown = ['ArrowUp', 'ArrowDown'].includes(key);
+  const isArrowDown = key === 'ArrowDown';
+
+  if (isArrowUpOrDown) {
+    const increment = isArrowDown ? 1 : -1;
+    const maxIndex = Math.max(_.chain(filteredSearchResult.value).values().flatten().size().value() - 1, 0);
+
+    selectedOptionIndex.value = Math.min(Math.max(selectedOptionIndex.value + increment, 0), maxIndex);
+
+    return;
+  }
+
+  if (isEnterPressed) {
+    const option = _.chain(filteredSearchResult.value)
+      .values()
+      .flatten()
+      .nth(selectedOptionIndex.value)
+      .value();
+
+    activateOption(option);
+  }
+}
+
+function getOptionIndex(option: PaletteOption) {
+  return _.chain(filteredSearchResult.value)
+    .values()
+    .flatten()
+    .findIndex(o => o === option)
+    .value();
+}
+
+function activateOption(option: PaletteOption) {
+  const { closeOnSelect } = option;
+
+  if (option.action) {
+    option.action();
+
+    if (closeOnSelect) {
+      commandPaletteStore.close();
+    }
+
+    return;
+  }
+
+  const closeAfterNavigation = closeOnSelect || _.isUndefined(closeOnSelect);
+
+  if (option.to) {
+    router.push(option.to);
+
+    if (closeAfterNavigation) {
+      commandPaletteStore.close();
+    }
+    return;
+  }
+
+  if (option.href) {
+    window.open(option.href, '_blank');
+
+    if (closeAfterNavigation) {
+      commandPaletteStore.close();
+    }
+  }
+}
+</script>
+
+<template>
+  <c-modal v-model:open="isOpen" class="palette-modal" shadow-xl important:max-w-650px important:pa-12px @keydown="handleKeydown">
+    <c-input-text ref="inputRef" v-model:value="searchPrompt" raw-text placeholder="Type to search a tool or a command..." autofocus clearable />
+
+    <div v-for="(options, category) in filteredSearchResult" :key="category">
+      <div ml-3 mt-3 text-sm font-bold text-primary op-60>
+        {{ category }}
+      </div>
+      <command-palette-option v-for="option in options" :key="option.name" :option="option" :selected="selectedOptionIndex === getOptionIndex(option)" @activated="activateOption" />
+    </div>
+  </c-modal>
+</template>
+
+<style scoped lang="less">
+.c-input-text {
+  font-size: 18px;
+
+  ::v-deep(.input-wrapper) {
+      padding: 4px;
+      padding-left: 18px;
+  }
+}
+
+.c-modal--overlay {
+  align-items: flex-start !important;
+  padding-top: 80px;
+}
+
+@media (max-width: 700px) {
+  // 窄屏下贴近顶部呈现，并让出安全区
+  .c-modal--overlay {
+    padding-top: calc(16px + env(safe-area-inset-top, 0px));
+  }
+}
+</style>

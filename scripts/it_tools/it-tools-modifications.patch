diff --git a/src/modules/host-bridge/host-bridge.ts b/src/modules/host-bridge/host-bridge.ts
new file mode 100644
index 0000000..d676e27
--- /dev/null
+++ b/src/modules/host-bridge/host-bridge.ts
@@ -0,0 +1,240 @@
+import type { Router } from 'vue-router';
+import { useHostBridgeStore } from './host-bridge.store';
+import { useCommandPaletteStore } from '@/modules/command-palette/command-palette.store';
+import { useHostThemeStore } from '@/stores/host-theme.store';
+import { useStyleStore } from '@/stores/style.store';
+import { useToolStore } from '@/tools/tools.store';
+
+export type HostThemePayload = {
+  /** 宿主 App 的品牌主色，支持 '#abc' / '#aabbcc' / '#aabbccdd'；null 表示恢复内置色板 */
+  primaryColor?: string | null
+  /** 强制明/暗，不传则由页面自身决定 */
+  isDark?: boolean
+};
+
+/** 回传给宿主的页面状态（供 Flutter 侧同步导航头） */
+export type HostState = {
+  path: string
+  isDark: boolean
+  menuOpen: boolean
+  locale: string
+};
+
+/** 推给宿主的工具清单（内嵌模式下由 Flutter 用原生组件展示） */
+export type HostToolGroup = {
+  category: string
+  tools: { path: string, name: string, description: string }[]
+};
+
+const THEME_MESSAGE_TYPE = 'it-tools:theme';
+const STATE_HANDLER = 'itToolsState';
+const TOOLS_HANDLER = 'itToolsTools';
+
+declare global {
+  interface Window {
+    ItTools?: {
+      setTheme?: (payload: HostThemePayload) => void
+      openMenu?: () => void
+      closeMenu?: () => void
+      toggleMenu?: () => void
+      openSearch?: () => void
+      goHome?: () => void
+      navigateTo?: (path: string) => void
+      setLocale?: (locale: string) => void
+      getState?: () => HostState | null
+    }
+  }
+}
+
+function parseBoolean(value: string | null): boolean | undefined {
+  if (value === null) {
+    return undefined;
+  }
+
+  const normalized = value.toLowerCase();
+
+  if (['1', 'true', 'yes', 'dark'].includes(normalized)) {
+    return true;
+  }
+
+  if (['0', 'false', 'no', 'light'].includes(normalized)) {
+    return false;
+  }
+
+  return undefined;
+}
+
+/**
+ * 同时支持参数落在 '?' 上（`index.html?hostTheme=...`）
+ * 和落在 hash 里（`index.html#/tool?hostTheme=...`）两种写法。
+ */
+function readQueryParams(): URLSearchParams {
+  const params = new URLSearchParams(window.location.search);
+  const hash = window.location.hash;
+  const hashQueryIndex = hash.indexOf('?');
+
+  if (hashQueryIndex !== -1) {
+    new URLSearchParams(hash.slice(hashQueryIndex + 1)).forEach((value, key) => {
+      if (!params.has(key)) {
+        params.set(key, value);
+      }
+    });
+  }
+
+  return params;
+}
+
+/** 把数据推给宿主（Android/iOS 两种 WebView 都覆盖） */
+function callHost(handler: string, payload: unknown) {
+  const w = window as unknown as {
+    flutter_inappwebview?: { callHandler?: (name: string, ...args: unknown[]) => void }
+    webkit?: { messageHandlers?: Record<string, { postMessage: (msg: unknown) => void }> }
+  };
+
+  try {
+    if (typeof w.flutter_inappwebview?.callHandler === 'function') {
+      w.flutter_inappwebview.callHandler(handler, payload);
+      return;
+    }
+    w.webkit?.messageHandlers?.[handler]?.postMessage(payload);
+  } catch {
+    // 宿主没接桥时静默：这是可选能力，不应影响页面本身
+  }
+}
+
+/** 把状态回传给宿主 */
+export function notifyHostState(state: HostState) {
+  callHost(STATE_HANDLER, state);
+}
+
+/**
+ * 把工具清单回传给宿主。
+ *
+ * 内嵌模式下页内抽屉由 Flutter 的原生组件替代，清单必须由页面提供
+ * （分类名与工具名都已按当前语言本地化）。
+ */
+export function notifyHostTools(groups: HostToolGroup[]) {
+  callHost(TOOLS_HANDLER, groups);
+}
+
+/**
+ * 早期初始化（main.ts 中、pinia 装好之后立即调用）。
+ *
+ * 只做「必须在首帧前生效」的事：
+ *  1. 应用 URL 上的宿主主题（避免默认色闪一下）
+ *  2. 识别内嵌模式（`hostEmbed=1`），供页面隐藏导航头
+ *
+ * 完整 API 需要 router/i18n，必须等 App 挂载，见 [installHostApi]。
+ */
+export function initHostBridge() {
+  const styleStore = useStyleStore();
+  const hostThemeStore = useHostThemeStore();
+  const hostBridgeStore = useHostBridgeStore();
+
+  function applyTheme(payload: HostThemePayload) {
+    if (payload.primaryColor !== undefined) {
+      hostThemeStore.setPrimaryColor(payload.primaryColor);
+    }
+
+    if (typeof payload.isDark === 'boolean') {
+      styleStore.isDarkTheme = payload.isDark;
+    }
+  }
+
+  const query = readQueryParams();
+  const queryPrimary = query.get('hostTheme') ?? query.get('host_theme');
+  const queryDark = parseBoolean(query.get('hostDark') ?? query.get('host_dark'));
+
+  applyTheme({
+    ...(queryPrimary !== null ? { primaryColor: queryPrimary } : {}),
+    ...(queryDark !== undefined ? { isDark: queryDark } : {}),
+  });
+
+  hostBridgeStore.embed = parseBoolean(query.get('hostEmbed') ?? query.get('host_embed')) === true;
+  if (hostBridgeStore.embed) {
+    document.documentElement.classList.add('host-embed');
+  }
+
+  window.addEventListener('message', (event: MessageEvent) => {
+    const data = event.data as { type?: string; payload?: HostThemePayload } | null;
+
+    if (!data || typeof data !== 'object' || data.type !== THEME_MESSAGE_TYPE) {
+      return;
+    }
+
+    applyTheme(data.payload ?? {});
+  });
+}
+
+/**
+ * 安装完整桥接 API（在 App.vue 的 setup 里同步调用，此时 router/i18n 可用）。
+ *
+ * 页面侧暴露 `window.ItTools`，宿主可据此驱动页面；同时在状态变化时
+ * 通过 [notifyHostState] 主动回报，让 Flutter 的导航头能同步。
+ */
+export function installHostApi({ router }: { router: Router }) {
+  const styleStore = useStyleStore();
+  const hostThemeStore = useHostThemeStore();
+  const commandPaletteStore = useCommandPaletteStore();
+  const { locale } = useI18n();
+  const route = useRoute();
+
+  function getState(): HostState {
+    return {
+      path: route.fullPath,
+      isDark: styleStore.isDarkTheme,
+      menuOpen: !styleStore.isMenuCollapsed,
+      locale: locale.value,
+    };
+  }
+
+  window.ItTools = {
+    ...window.ItTools,
+    setTheme: (payload: HostThemePayload) => {
+      if (payload.primaryColor !== undefined) {
+        hostThemeStore.setPrimaryColor(payload.primaryColor);
+      }
+      if (typeof payload.isDark === 'boolean') {
+        styleStore.isDarkTheme = payload.isDark;
+      }
+    },
+    openMenu: () => {
+      styleStore.isMenuCollapsed = false;
+    },
+    closeMenu: () => {
+      styleStore.isMenuCollapsed = true;
+    },
+    toggleMenu: () => {
+      styleStore.isMenuCollapsed = !styleStore.isMenuCollapsed;
+    },
+    openSearch: () => commandPaletteStore.open(),
+    goHome: () => router.push('/'),
+    navigateTo: (path: string) => router.push(path),
+    setLocale: (next: string) => {
+      locale.value = next;
+    },
+    getState,
+  };
+
+  // 状态变化主动回报宿主（导航头要跟着变）
+  watch(
+    [() => route.fullPath, () => styleStore.isDarkTheme, () => styleStore.isMenuCollapsed, locale],
+    () => notifyHostState(getState()),
+    { immediate: true },
+  );
+
+  // 工具清单：挂载时推一次；语言切换后分类名/工具名会变，需重新推
+  const toolStore = useToolStore();
+  watch(
+    () => toolStore.toolsByCategory,
+    groups => notifyHostTools(groups.map(group => ({
+      category: group.name,
+      tools: group.components.map(tool => ({
+        path: tool.path,
+        name: tool.name,
+        description: tool.description,
+      })),
+    }))),
+    { immediate: true },
+  );
+}

+/**
+ * 响应式断点单一来源。
+ *
+ * 组件里需要 JS 侧断点判断时一律从这里取，避免魔法数字散落在各处。
+ * CSS 侧仍使用媒体查询，但阈值应与这里保持一致。
+ */
+export const breakpoints = {
+  /** 手机竖屏上限 / 导航折叠阈值（沿用既有 isSmallScreen 语义，勿随意改动） */
+  smallScreen: 700,
+  /** 平板与桌面分界 */
+  desktop: 1024,
+} as const;
+
+export const mediaQueries = {
+  /** <=700px：导航折叠、AppBar 形态切换 */
+  smallScreen: `(max-width: ${breakpoints.smallScreen}px)`,
+  /** <600px：最紧凑内容间距 */
+  mobile: '(max-width: 599px)',
+  /** 600–1023px */
+  tablet: `(min-width: 600px) and (max-width: ${breakpoints.desktop - 1}px)`,
+  /** >=1024px */
+  desktop: `(min-width: ${breakpoints.desktop}px)`,
+  /** 触控设备（无 hover + 粗指针） */
+  touch: '(hover: none) and (pointer: coarse)',
+} as const;

new file mode 100644
index 0000000..4e856e2
--- /dev/null
+++ b/src/tools/text-diff/text-diff-mobile.vue
@@ -0,0 +1,78 @@
+<script setup lang="ts">
+import { setOpacity } from '@/ui/color/color.models';
+import { useAppTheme } from '@/ui/theme/themes';
+import { MAX_DIFF_LINES, countChanges, diffLines } from './text-diff.models';
+
+// 移动端降级视图：Monaco diff 编辑器在手机上几乎不可用（触控/虚拟键盘/600px 定高），
+// 这里改为「两个多行输入框 + 统一行级 diff」，同时避免下载 Monaco 那 ~3MB。
+const appTheme = useAppTheme();
+
+const original = ref('');
+const modified = ref('');
+
+const tooLarge = computed(() =>
+  original.value.split('\n').length > MAX_DIFF_LINES
+  || modified.value.split('\n').length > MAX_DIFF_LINES);
+
+const rows = computed(() => (tooLarge.value ? [] : diffLines(original.value, modified.value)));
+const changes = computed(() => countChanges(rows.value));
+
+// 颜色取自应用主题（响应式），保证深色模式下同样可读
+const addedFg = computed(() => appTheme.value.success.color);
+const addedBg = computed(() => setOpacity(appTheme.value.success.color, 0.14));
+const removedFg = computed(() => appTheme.value.error.color);
+const removedBg = computed(() => setOpacity(appTheme.value.error.color, 0.14));
+</script>
+
+<template>
+  <div flex flex-col gap-3 w-full>
+    <c-card :title="$t('tools.text-diff.original')">
+      <c-input-text
+        v-model:value="original"
+        multiline
+        :placeholder="$t('tools.text-diff.originalPlaceholder')"
+        raw-text
+        rows="6"
+      />
+    </c-card>
+
+    <c-card :title="$t('tools.text-diff.modified')">
+      <c-input-text
+        v-model:value="modified"
+        multiline
+        :placeholder="$t('tools.text-diff.modifiedPlaceholder')"
+        raw-text
+        rows="6"
+      />
+    </c-card>
+
+    <c-card :title="$t('tools.text-diff.result')">
+      <div v-if="tooLarge" op-60>
+        {{ $t('tools.text-diff.tooManyLines', { max: MAX_DIFF_LINES }) }}
+      </div>
+      <div v-else-if="rows.length === 0" op-60>
+        {{ $t('tools.text-diff.noDifferences') }}
+      </div>
+      <div v-else flex flex-col gap-1 overflow-x-auto>
+        <div flex items-center gap-3 mb-1 text-xs op-70>
+          <span :style="{ color: addedFg }">+{{ changes.added }}</span>
+          <span :style="{ color: removedFg }">−{{ changes.removed }}</span>
+        </div>
+        <div
+          v-for="(row, idx) in rows"
+          :key="idx"
+          flex gap-2 rounded px-2 py-1 font-mono text-13px
+          :style="{
+            backgroundColor: row.type === 'add' ? addedBg : row.type === 'del' ? removedBg : undefined,
+            color: row.type === 'add' ? addedFg : row.type === 'del' ? removedFg : undefined,
+          }"
+        >
+          <span w-4 flex-shrink-0 text-right op-50 select-none>
+            {{ row.type === 'add' ? '+' : row.type === 'del' ? '−' : '' }}
+          </span>
+          <span whitespace-pre-wrap break-all>{{ row.text }}</span>
+        </div>
+      </div>
+    </c-card>
+  </div>
+</template>
diff --git a/src/tools/text-diff/text-diff.models.test.ts b/src/tools/text-diff/text-diff.models.test.ts
new file mode 100644
index 0000000..84f92a4
--- /dev/null
+++ b/src/tools/text-diff/text-diff.models.test.ts
@@ -0,0 +1,51 @@
+import { describe, expect, it } from 'vitest';
+import { countChanges, diffLines } from './text-diff.models';
+
+describe('text-diff.models', () => {
+  it('内容一致时全部为 same，且没有增删', () => {
+    const rows = diffLines('a\nb\nc', 'a\nb\nc');
+
+    expect(rows.map(r => r.type)).toEqual(['same', 'same', 'same']);
+    expect(countChanges(rows)).toEqual({ added: 0, removed: 0 });
+  });
+
+  it('识别新增行', () => {
+    const rows = diffLines('a\nc', 'a\nb\nc');
+
+    expect(rows.map(r => r.type)).toEqual(['same', 'add', 'same']);
+    expect(countChanges(rows)).toEqual({ added: 1, removed: 0 });
+    expect(rows[1].text).toBe('b');
+  });
+
+  it('识别删除行', () => {
+    const rows = diffLines('a\nb\nc', 'a\nc');
+
+    expect(rows.map(r => r.type)).toEqual(['same', 'del', 'same']);
+    expect(countChanges(rows)).toEqual({ added: 0, removed: 1 });
+    expect(rows[1].text).toBe('b');
+  });
+
+  it('修改一行 → 一个 del + 一个 add', () => {
+    const rows = diffLines('a\nOLD\nc', 'a\nNEW\nc');
+
+    expect(countChanges(rows)).toEqual({ added: 1, removed: 1 });
+    expect(rows.map(r => r.text)).toContain('OLD');
+    expect(rows.map(r => r.text)).toContain('NEW');
+  });
+
+  it('行号：删除行只带 oldLine，新增行只带 newLine', () => {
+    const rows = diffLines('a\nb', 'a\nx');
+    const del = rows.find(r => r.type === 'del');
+    const add = rows.find(r => r.type === 'add');
+
+    expect(del).toMatchObject({ text: 'b', oldLine: 2 });
+    expect(del?.newLine).toBeUndefined();
+    expect(add).toMatchObject({ text: 'x', newLine: 2 });
+    expect(add?.oldLine).toBeUndefined();
+  });
+
+  it('空输入不报错', () => {
+    expect(diffLines('', '')).toHaveLength(1); // 两个空串都 split 成 ['']，视为一行相同
+    expect(countChanges(diffLines('', 'a'))).toEqual({ added: 1, removed: 1 });
+  });
+});
diff --git a/src/tools/text-diff/text-diff.models.ts b/src/tools/text-diff/text-diff.models.ts
new file mode 100644
index 0000000..fabf164
--- /dev/null
+++ b/src/tools/text-diff/text-diff.models.ts
@@ -0,0 +1,67 @@
+export type DiffRowType = 'same' | 'del' | 'add';
+
+export type DiffRow = {
+  type: DiffRowType;
+  text: string;
+  /** 原文行号（1 起，删除/相同行有值） */
+  oldLine?: number;
+  /** 新文行号（1 起，新增/相同行有值） */
+  newLine?: number;
+};
+
+/** LCS 是 O(n*m)，超过这个行数就放弃逐行比对，避免在手机上把内存打爆 */
+export const MAX_DIFF_LINES = 1500;
+
+/**
+ * 行级差分（统一 diff 的简化版，不做上下文裁剪）。
+ * 返回按顺序展开的行列表，调用方据此渲染 `−` / `+` 行。
+ */
+export function diffLines(original: string, modified: string): DiffRow[] {
+  const a = original.split('\n');
+  const b = modified.split('\n');
+  const n = a.length;
+  const m = b.length;
+
+  // dp[i][j] = a[i..] 与 b[j..] 的最长公共子序列长度
+  const dp: Uint32Array[] = Array.from({ length: n + 1 }, () => new Uint32Array(m + 1));
+
+  for (let i = n - 1; i >= 0; i--) {
+    for (let j = m - 1; j >= 0; j--) {
+      dp[i][j] = a[i] === b[j]
+        ? dp[i + 1][j + 1] + 1
+        : Math.max(dp[i + 1][j], dp[i][j + 1]);
+    }
+  }
+
+  const rows: DiffRow[] = [];
+  let i = 0;
+  let j = 0;
+
+  while (i < n && j < m) {
+    if (a[i] === b[j]) {
+      rows.push({ type: 'same', text: a[i], oldLine: i + 1, newLine: j + 1 });
+      i++;
+      j++;
+    }
+    else if (dp[i + 1][j] >= dp[i][j + 1]) {
+      rows.push({ type: 'del', text: a[i], oldLine: i + 1 });
+      i++;
+    }
+    else {
+      rows.push({ type: 'add', text: b[j], newLine: j + 1 });
+      j++;
+    }
+  }
+
+  while (i < n) rows.push({ type: 'del', text: a[i], oldLine: ++i });
+  while (j < m) rows.push({ type: 'add', text: b[j], newLine: ++j });
+
+  return rows;
+}
+
+export function countChanges(rows: DiffRow[]) {
+  return {
+    added: rows.filter(r => r.type === 'add').length,
+    removed: rows.filter(r => r.type === 'del').length,

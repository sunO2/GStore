--- /dev/null
+++ b/src/ui/theme/app-theme.ts
@@ -0,0 +1,135 @@
+import type { PrimaryPalette } from './theme.types';
+import { useHostThemeStore } from '@/stores/host-theme.store';
+import { useStyleStore } from '@/stores/style.store';
+import { darken, lighten, normalizeHex, setOpacity } from '../color/color.models';
+
+export type ThemeStyle = 'light' | 'dark';
+
+export type AppTheme = {
+  background: string
+  text: { baseColor: string; mutedColor: string }
+  default: { color: string; colorHover: string; colorPressed: string }
+  primary: PrimaryPalette
+  warning: PrimaryPalette
+  success: PrimaryPalette
+  error: PrimaryPalette
+};
+
+/**
+ * 内置基础色板。
+ * primary 是唯一允许被宿主 App 覆盖的一组（见 derivePrimary），其余保持固定。
+ */
+const baseThemes: Record<ThemeStyle, AppTheme> = {
+  light: {
+    background: '#ffffff',
+    text: {
+      baseColor: '#333639',
+      mutedColor: '#767c82',
+    },
+    default: {
+      color: 'rgba(46, 51, 56, 0.05)',
+      colorHover: 'rgba(46, 51, 56, 0.09)',
+      colorPressed: 'rgba(46, 51, 56, 0.22)',
+    },
+    primary: {
+      color: '#18a058',
+      colorHover: '#1ea54c',
+      colorPressed: '#0C7A43',
+      colorFaded: '#18a0582f',
+    },
+    warning: {
+      color: '#f59e0b',
+      colorHover: '#f59e0b',
+      colorPressed: '#f59e0b',
+      colorFaded: '#f59e0b2f',
+    },
+    success: {
+      color: '#18a058',
+      colorHover: '#36ad6a',
+      colorPressed: '#0c7a43',
+      colorFaded: '#18a0582f',
+    },
+    error: {
+      color: '#d03050',
+      colorHover: '#de576d',
+      colorPressed: '#ab1f3f',
+      colorFaded: '#d030502a',
+    },
+  },
+  dark: {
+    background: '#1e1e1e',
+    text: {
+      baseColor: '#ffffffd1',
+      mutedColor: '#ffffff80',
+    },
+    default: {
+      color: 'rgba(255, 255, 255, 0.08)',
+      colorHover: 'rgba(255, 255, 255, 0.12)',
+      colorPressed: 'rgba(255, 255, 255, 0.24)',
+    },
+    primary: {
+      color: '#1ea54c',
+      colorHover: '#36AD6A',
+      colorPressed: '#0C7A43',
+      colorFaded: '#18a0582f',
+    },
+    warning: {
+      color: '#f59e0b',
+      colorHover: '#f59e0b',
+      colorPressed: '#f59e0b',
+      colorFaded: '#f59e0b2f',
+    },
+    success: {
+      color: '#18a058',
+      colorHover: '#36ad6a',
+      colorPressed: '#0c7a43',
+      colorFaded: '#18a0582f',
+    },
+    error: {
+      color: '#e88080',
+      colorHover: '#e98b8b',
+      colorPressed: '#e57272',
+      colorFaded: '#e8808029',
+    },
+  },
+};
+
+/**
+ * 由宿主提供的单一主色推导出完整 primary 色板。
+ * 明暗两套的明暗偏移量不同，沿用各自原有色板的观感。
+ */
+function derivePrimary(color: string, style: ThemeStyle): PrimaryPalette | null {
+  const base = normalizeHex(color);
+
+  if (!base) {
+    return null;
+  }
+
+  return {
+    color: base,
+    colorHover: lighten(base, style === 'dark' ? 20 : 16),
+    colorPressed: darken(base, style === 'dark' ? 18 : 22),
+    colorFaded: setOpacity(base, 0.18),
+  };
+}
+
+export function buildAppTheme(style: ThemeStyle, hostPrimaryColor: string | null): AppTheme {
+  const base = baseThemes[style];
+
+  if (!hostPrimaryColor) {
+    return base;
+  }
+
+  const primary = derivePrimary(hostPrimaryColor, style);
+
+  return primary ? { ...base, primary } : base;
+}
+
+export function useAppTheme() {
+  const styleStore = useStyleStore();
+  const hostThemeStore = useHostThemeStore();
+
+  return computed(() =>
+    buildAppTheme(styleStore.isDarkTheme ? 'dark' : 'light', hostThemeStore.primaryColor),
+  );
+}

new file mode 100644
index 0000000..921374a
--- /dev/null
+++ b/scripts/build-embed.mjs
@@ -0,0 +1,88 @@
+#!/usr/bin/env node
+/**
+ * 构建「离线内嵌包」——给宿主 App 打包进 assets 用。
+ *
+ * 与默认 `build` 的三点差异：
+ *   BASE_URL=./            资源全部相对路径，放在任意目录层级都能直接打开
+ *   VITE_ROUTER_MODE=hash  不依赖服务端 history 回退，file:// 也能深链到工具页
+ *   VITE_PWA=disabled      不生成 Service Worker，避免 WebView 内缓存出陈旧页面
+ *
+ * 产物：dist-embed/（目录）+ dist-embed.zip（系统有 zip 命令时）
+ * 用法：pnpm build:embed
+ *
+ * 可选：设置 GSTORE_ASSETS_DIR 指向宿主 App 的资产目录，构建后自动把 zip 同步过去，
+ * 避免手工复制遗漏（宿主侧还需要提升版本号才会重新解压，见 GStore 侧的文档）。
+ *
+ *   GSTORE_ASSETS_DIR=~/develop/flutter/project/GStore/assets/it_tools pnpm build:embed
+ */
+import { execFileSync } from 'node:child_process';
+import { copyFileSync, existsSync, mkdirSync, readdirSync, readFileSync, rmSync, statSync } from 'node:fs';
+import { dirname, resolve } from 'node:path';
+import { fileURLToPath } from 'node:url';
+
+const root = resolve(dirname(fileURLToPath(import.meta.url)), '..');
+process.chdir(root);
+
+const outDir = process.env.EMBED_OUT_DIR ?? 'dist-embed';
+const pkg = JSON.parse(readFileSync(resolve(root, 'package.json'), 'utf8'));
+
+process.env.NODE_ENV = 'production';
+process.env.BASE_URL = process.env.BASE_URL ?? './';
+process.env.VITE_ROUTER_MODE = 'hash';
+process.env.VITE_ROUTER_BASE = process.env.VITE_ROUTER_BASE ?? '/';
+process.env.VITE_PWA = 'disabled';
+process.env.VITE_VERCEL_ENV = 'production';
+process.env.PACKAGE_VERSION = pkg.version;
+process.env.npm_package_version = pkg.version;
+
+const { build } = await import('vite');
+
+await build({ build: { outDir, emptyOutDir: true } });
+
+const outPath = resolve(root, outDir);
+const zipName = `${outDir}.zip`;
+const zipPath = resolve(root, zipName);
+
+if (existsSync(zipPath)) {
+  rmSync(zipPath);
+}
+
+let zipped = false;
+try {
+  execFileSync('zip', ['-qr', zipPath, '.'], { cwd: outPath });
+  zipped = true;
+} catch {
+  // zip 命令缺失不视为失败，目录本身已是完整产物
+}
+
+const toMb = (bytes) => `${(bytes / 1024 / 1024).toFixed(2)} MB`;
+
+function dirSize(dir) {
+  return readdirSync(dir, { withFileTypes: true }).reduce(
+    (total, entry) => total + (entry.isDirectory() ? dirSize(resolve(dir, entry.name)) : statSync(resolve(dir, entry.name)).size),
+    0,
+  );
+}
+
+console.log('\n=== 离线内嵌包 ===');
+console.log(`目录: ${outDir}/ (${toMb(dirSize(outPath))})`);
+if (zipped) {
+  console.log(`压缩: ${zipName} (${toMb(statSync(zipPath).size)})`);
+} else {
+  console.log(`未生成 ${zipName}：系统缺少 zip 命令，请直接打包 ${outDir}/ 目录`);
+}
+
+// 可选：同步到宿主 App 的资产目录
+const gstoreAssetsDir = process.env.GSTORE_ASSETS_DIR;
+if (gstoreAssetsDir) {
+  try {
+    const targetDir = resolve(gstoreAssetsDir.replace(/^~/, process.env.HOME ?? '~'));
+    mkdirSync(targetDir, { recursive: true });
+    const targetZip = resolve(targetDir, 'it-tools.zip');
+    copyFileSync(zipPath, targetZip);
+    console.log(`已同步到宿主资产: ${targetZip} (${toMb(statSync(targetZip).size)})`);
+    console.log('提醒：宿主侧需提升 pubspec.yaml 版本号，否则不会重新解压。');
+  } catch (e) {
+    console.log(`同步到 GSTORE_ASSETS_DIR 失败（不影响构建结果）: ${e.message}`);
+  }
+}

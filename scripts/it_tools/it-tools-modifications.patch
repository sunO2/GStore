+import { defineStore } from 'pinia';
+import { normalizeHex } from '@/ui/color/color.models';
+
+/**
+ * 宿主 App 传入的主题。
+ * 目前只承载主色：置空表示使用内置色板。
+ */
+export const useHostThemeStore = defineStore('hostTheme', {
+  state: () => ({
+    primaryColor: null as string | null,
+  }),
+  actions: {
+    setPrimaryColor(color: string | null | undefined) {
+      // 非法色值一律视为「不覆盖」，避免把内置色板改坏
+      this.primaryColor = typeof color === 'string' ? normalizeHex(color) : null;
+    },
+  },
+});
